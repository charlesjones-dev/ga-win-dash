{
  "name": "ga-win-dash",
  "version": "1.0.0",
  "description": "Windows dashboard for viewing multiple Google Analytics dashboards in a configurable grid layout",
  "main": "./out/main/index.js",
  "author": "Charles Jones",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win portable",
    "package:installer": "electron-vite build && electron-builder --win nsis",
    "package:msi": "electron-vite build && electron-builder --win msi",
    "setup:msi": "winget install --id WiXToolset.WiXToolset --source winget",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "audit:deps": "pnpm audit",
    "audit:sast": "docker run --rm -v .:/src semgrep/semgrep semgrep scan --config auto /src",
    "audit:all": "pnpm run audit:deps & pnpm run audit:sast",
    "clean": "rimraf node_modules out dist"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "tar": ">=7.5.7"
    }
  }
}
